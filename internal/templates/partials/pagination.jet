{{if .Total > 1}}
<div class="flex items-center justify-center gap-2 mt-4">
  <!-- prev -->
  {{if .Current > 1}}
    <a href="{{pageURL(., .Current - 1)}}" class="border border-neutral-700 hover:bg-neutral-800 rounded-md px-2 py-1 text-sm">←</a>
  {{else}}
    <span class="border border-neutral-700 text-neutral-600 rounded-md px-2 py-1 text-sm opacity-50 cursor-not-allowed">←</span>
  {{end}}

  <!-- numbered pages -->
  {{pages := pageWindow(.Current, .Total)}}
  {{range i, n := pages}}
    {{if n == 0}}
      <span class="px-1.5 text-neutral-500">…</span>
    {{else}}
      {{if n == .Current}}
        <span class="bg-indigo-500 text-white rounded-md px-2.5 py-1 text-sm">{{n}}</span>
      {{else}}
        <a href="{{pageURL(., n)}}" class="border border-neutral-700 hover:bg-neutral-800 text-neutral-300 rounded-md px-2.5 py-1 text-sm">{{n}}</a>
      {{end}}
    {{end}}
  {{end}}

  <!-- next -->
  {{if .Current < .Total}}
    <a href="{{pageURL(., .Current + 1)}}" class="border border-neutral-700 hover:bg-neutral-800 rounded-md px-2 py-1 text-sm">→</a>
  {{else}}
    <span class="border border-neutral-700 text-neutral-600 rounded-md px-2 py-1 text-sm opacity-50 cursor-not-allowed">→</span>
  {{end}}
</div>
{{end}}
