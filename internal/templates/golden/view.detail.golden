            <button onclick="var m=this.closest('#cover-modal');m.classList.add('hidden');m.style.display='none'" class="text-neutral-400 hover:text-neutral-200 text-lg leading-none" aria-label="Close">&times;</button>
        </div>
        <div class="flex flex-wrap gap-3"><form action="/action/set-cover/md/s1" method="POST" class="group relative w-32"><input type="hidden" name="csrf_token" value=""><input type="hidden" name="url" value="https://cdn.test/c.jpg"><img src="/image?pluginID=md&url=https://cdn.test/c.jpg&prio=high" alt="cover" loading="lazy" class="w-32 aspect-[2/3] rounded-lg object-cover border-2 transition cursor-pointer border-emerald-500" onclick="submitForm(this.closest('form'))" title="Use this cover"><div class="text-xs text-neutral-400 text-center mt-1 truncate">current</div></form><form action="/action/set-cover/md/s1" method="POST" class="group relative w-32"><input type="hidden" name="csrf_token" value=""><input type="hidden" name="url" value="https://cdn.test/alt.jpg"><img src="/image?pluginID=md&url=https://cdn.test/alt.jpg&prio=high" alt="cover" loading="lazy" class="w-32 aspect-[2/3] rounded-lg object-cover border-2 transition cursor-pointer border-transparent group-hover:border-blue-400" onclick="submitForm(this.closest('form'))" title="Use this cover"><div class="text-xs text-neutral-400 text-center mt-1 truncate"></div></form></div>
        <div class="mt-4 flex items-center gap-2">
            <form action="/action/clear-covers/md/s1" method="POST" class="inline">
                <input type="hidden" name="csrf_token" value="">                <button type="submit" class="text-xs text-red-400 hover:text-red-300 border border-red-600/50 rounded-md px-3 py-1" onclick="return confirm('Clear all cover candidates and fetch fresh?');">Clear Covers</button>
            </form>
            <form action="/action/fetch-covers/md/s1" method="POST" class="inline">
                <input type="hidden" name="csrf_token" value="">                <input type="hidden" name="manga_title" value="Golden Manga" />
                <button type="submit" class="text-xs text-blue-400 hover:text-blue-300 border border-blue-600/50 rounded-md px-3 py-1">Refresh Covers</button>
            </form>
        </div>
    </div>
</div>
    </main>
    <script src="/static/lib/alpine-components.js"></script>
    <script src="/static/lib/mermaid.min.js" defer></script>
    <script defer src="/static/lib/alpine.min.js"></script>
<div id="toast-region" x-data x-init="$store.toast.render($el)" class="fixed bottom-4 left-4 z-50 space-y-2"></div>

<style>
  .toast-item { opacity: 0; transform: translateY(8px); transition: opacity .18s ease, transform .18s ease; }
  .toast-item.toast-visible { opacity: 1; transform: translateY(0); }
  .toast-item.toast-leave { opacity: 0; transform: translateY(8px); }
</style>

<div id="confirm-modal" x-data x-init="$store.confirm.mount($el)" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50" style="display:none">
    <div class="relative bg-neutral-900 border border-neutral-700 rounded-lg shadow-xl w-full max-w-sm p-5">
        <p id="confirm-message" class="text-sm text-neutral-200 mb-4"></p>
        <div class="flex justify-end gap-2">
            <button type="button" id="confirm-cancel" class="border border-neutral-700 hover:bg-neutral-800 text-neutral-300 rounded-md px-3 py-1.5 text-sm">Cancel</button>
            <button type="button" id="confirm-ok" class="bg-red-600 hover:bg-red-500 text-white rounded-md px-3 py-1.5 text-sm font-medium">Confirm</button>
        </div>
    </div>
</div>
</body>
</html>