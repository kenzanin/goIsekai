<div class="space-y-3"><div class="bg-neutral-900 rounded-lg p-4 border border-neutral-800"><div class="flex items-center gap-3"><div class="h-10 w-10 rounded-md bg-indigo-500/15 text-indigo-400 flex items-center justify-center text-sm font-semibold shrink-0">PP</div><div class="min-w-0 flex-1"><div class="font-medium text-sm flex items-center gap-2">Plugin P</div><div class="text-xs text-neutral-500">0 manga</div><div class="text-xs font-mono text-neutral-500 truncate">p</div></div><div class="flex items-center gap-2 shrink-0 flex-wrap"><select data-plugin-profile="p" class="bg-neutral-800 border border-neutral-700 rounded px-2 py-1 text-xs"><option value="">auto</option></select><button type="button" onclick="testProfile('p')" class="border border-neutral-700 text-neutral-400 hover:text-neutral-200 rounded px-2 py-1 text-xs">Test</button><span class="text-xs px-2 py-0.5 rounded-full bg-neutral-700/50 text-neutral-400">v1</span><span class="text-xs px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400">Active</span><span class="text-xs px-2 py-0.5 rounded-full bg-amber-500/15 text-amber-400">Deferred</span><form method="post" action="/action/toggle-plugin/p" data-confirm="Deactivate this plugin?"><input type="hidden" name="csrf_token" value=""><button type="submit" class="border border-neutral-700 text-neutral-400 hover:text-neutral-200 rounded-md px-3 py-1.5 text-sm">Deactivate</button></form></div></div></div></div>