<div class="mb-4 border-t border-neutral-800 pt-4"><button type="button" id="enrichment-btn" data-key="md:s1" onclick="var b=document.getElementById(&quot;enrichment-btn&quot;);var bd=document.getElementById(&quot;enrichment-body&quot;);bd.classList.toggle(&quot;hidden&quot;);b.querySelector(&quot;.chev&quot;).classList.toggle(&quot;rotate-90&quot;);try{localStorage.setItem(&quot;gsk:enrichment-open:&quot;+b.dataset.key,b.querySelector(&quot;.chev&quot;).classList.contains(&quot;rotate-90&quot;) ? &quot;1&quot; : &quot;0&quot;)}catch(e){}" class="flex items-center gap-1.5 cursor-pointer group select-none"><svg class="size-3.5 text-neutral-500 chev transition-transform" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg><span class="text-xs font-semibold text-neutral-300 uppercase tracking-wide">Enrichment</span></button><div id="enrichment-body" class="hidden" x-data="{ loading: false }"><div class="mb-3 flex items-center gap-2"><form method="post" action="/action/fetch-enrichment/md/s1"><input type="hidden" name="csrf_token" value=""><input type="hidden" name="manga_title" value="Golden Manga"><button type="submit" class="border border-indigo-600/50 text-indigo-300 hover:bg-indigo-600/20 rounded-md px-3 py-1.5 text-xs font-medium inline-flex items-center gap-1.5" @click="loading = true"><svg x-show="loading" class="size-3.5 animate-spin" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/><path d="M3.5 12h3.5"/><path d="M12 3.5v3.5"/></svg><span x-text="loading ? &quot;Fetching...&quot; : &quot;Fetch Details&quot;">Fetch Details</span></button></form><form method="post" action="/action/reset-enrichment/md/s1"><input type="hidden" name="csrf_token" value=""><button type="submit" class="border border-red-600/50 text-red-400 hover:bg-red-500/10 rounded-md px-3 py-1.5 text-xs font-medium" data-confirm="Reset all enrichment data to original plugin values?">Reset to Original</button></form></div><div class="mb-3"><span class="text-xs font-semibold text-neutral-400 uppercase">Alternative titles (1)</span><div class="flex flex-wrap gap-1.5 mt-1"><span class="inline-flex items-center gap-1.5 rounded-full bg-neutral-800 border border-indigo-700/60 pl-2.5 pr-1 py-0.5 text-xs"><span class="text-indigo-300" title="Current main title">Golden Manga</span><span class="text-xs px-1.5 py-0.5 rounded-full bg-indigo-900/40 text-indigo-300">via md</span></span><span class="inline-flex items-center gap-1.5 rounded-full bg-neutral-800 border border-neutral-700/60 pl-2.5 pr-1 py-0.5 text-xs"><form method="post" action="/action/set-title/md/s1" class="inline"><input type="hidden" name="csrf_token" value=""><input type="hidden" name="title" value="Alt One"><input type="hidden" name="_label" value="Set as main title"><span class="text-neutral-300 hover:text-indigo-300 cursor-pointer transition" @click="submitForm($el.closest(&apos;form&apos;))">Alt One</span></form><span class="text-xs px-1.5 py-0.5 rounded-full bg-neutral-700/50 text-neutral-400">via MangaDex</span><form method="post" action="/action/remove-alt-title/md/s1" class="inline-flex"><input type="hidden" name="csrf_token" value=""><input type="hidden" name="title" value="Alt One"><button type="submit" title="Remove alternative title" aria-label="Remove" class="size-4 inline-flex items-center justify-center rounded-full text-neutral-500 hover:text-red-400 hover:bg-neutral-700" data-confirm="Remove this alternative title?">&times;</button></form></span></div></div><div class="mb-3"><span class="text-xs font-semibold text-neutral-400 uppercase">Alternative synopses (1)</span><div class="flex items-start gap-2 py-1"><form method="post" action="/action/set-summary/md/s1" class="flex-1 min-w-0 group"><input type="hidden" name="csrf_token" value=""><input type="hidden" name="description" value="Alt synopsis."><span class="w-full text-left text-sm text-neutral-300 hover:text-indigo-300 transition cursor-pointer" @click="submitForm($el.closest(&apos;form&apos;))">Alt synopsis.</span></form><div class="flex items-center gap-1.5 shrink-0 mt-0.5"><span class="text-xs px-1.5 py-0.5 rounded-full bg-neutral-700/50 text-neutral-400">via MU</span><form method="post" action="/action/remove-alt-summary/md/s1" class="inline-flex"><input type="hidden" name="csrf_token" value=""><input type="hidden" name="description" value="Alt synopsis."><button type="submit" title="Remove alternative summary" aria-label="Remove" class="size-4 inline-flex items-center justify-center rounded-full text-neutral-500 hover:text-red-400 hover:bg-neutral-700" data-confirm="Remove this alternative synopsis?">&times;</button></form></div></div></div><div class="mb-3"><span class="text-xs font-semibold text-neutral-400 uppercase">Categories / Genres</span><div class="flex flex-wrap gap-1.5 mt-1"><form method="post" action="/action/remove-category/md/s1" class="inline"><input type="hidden" name="csrf_token" value=""><input type="hidden" name="category" value="Action"><span class="inline-flex items-center gap-1 rounded-full bg-indigo-500/20 border-indigo-600/60 text-indigo-300 cursor-pointer hover:bg-indigo-500/30" @click="submitForm($el.closest(&apos;form&apos;))">Action</span></form></div></div></div></div>