<a href="/view/search" class="rounded-md px-3 py-2 text-sm font-medium hover:bg-neutral-800" data-nav="search">Search</a>
<a href="/view/updates" class="rounded-md px-3 py-2 text-sm font-medium hover:bg-neutral-800" data-nav="updates">Updates</a>
<a href="/view/history" class="rounded-md px-3 py-2 text-sm font-medium hover:bg-neutral-800" data-nav="history">History</a>
<a href="/view/plugins" class="rounded-md px-3 py-2 text-sm font-medium hover:bg-neutral-800" data-nav="plugins">Plugins</a>
<a href="/view/settings" class="rounded-md px-3 py-2 text-sm font-medium hover:bg-neutral-800" data-nav="settings">Settings</a>
<a href="/view/logs" class="rounded-md px-3 py-2 text-sm font-medium hover:bg-neutral-800" data-nav="logs">Logs</a>
<a href="/view/about" class="rounded-md px-3 py-2 text-sm font-medium hover:bg-neutral-800 ml-auto" data-nav="about">About</a>
</nav>
    <main id="content" class="mx-auto w-full max-w-[95rem] px-4 py-8">
<h1 class="text-xl font-semibold mb-6">Search</h1><form method="get" action="/view/search" id="searchForm" class="mb-6"><div class="flex gap-2 items-end"><div class="relative"><label class="block text-xs text-neutral-400 mb-1">Plugin</label><button type="button" id="pluginPickerBtn" class="flex items-center gap-2 bg-neutral-900 border border-neutral-700 rounded-md px-3 py-2 text-sm min-w-[180px] text-left"><span id="pluginPickerLabel" class="truncate"></span></button><div id="pluginPickerDrop" class="hidden absolute z-20 mt-1 w-56 bg-neutral-900 border border-neutral-700 rounded-md shadow-lg py-1 max-h-64 overflow-auto"><button type="button" data-pick="p" data-pname="Plugin P" class="w-full flex items-center gap-2 px-3 py-2 text-sm text-left hover:bg-neutral-800"><span class="w-5 h-5 rounded bg-neutral-700 flex-shrink-0"></span>Plugin P</button></div><input type="hidden" id="pluginID" name="pluginID" value="" data-pname=""><select id="pluginIDNative" class="hidden"> <option value=p>Plugin P</option>
</select></div><div class="flex-1"><label for="q" class="block text-xs text-neutral-400 mb-1">&nbsp;</label><input id="q" name="q" type="text" value="golden" placeholder="Manga title..." class="w-full bg-neutral-900 border border-neutral-700 rounded-md px-3 py-2 text-sm"></div><button type="submit" class="bg-indigo-600 hover:bg-indigo-500 text-white rounded-md px-4 py-2 text-sm font-medium">Search</button></div></form><div id="search-history" class="mb-8"></div><script>(function(){
  var btn = document.getElementById('pluginPickerBtn'), drop = document.getElementById('pluginPickerDrop'), hid = document.getElementById('pluginID');
  if (btn && drop && hid) {
    btn.addEventListener('click', function () { drop.classList.toggle('hidden'); });
    drop.querySelectorAll('[data-pick]').forEach(function (el) {
      el.addEventListener('click', function () {
        hid.value = el.getAttribute('data-pick');
        hid.setAttribute('data-pname', el.getAttribute('data-pname') || el.getAttribute('data-pick'));
        document.getElementById('searchForm').submit();
      });
    });
    document.addEventListener('click', function (e) {
      if (!btn.contains(e.target) && !drop.contains(e.target)) drop.classList.add('hidden');
    });
  }
})();</script><div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-4"><a href="/view/manga//1" class="flex flex-col bg-neutral-900 rounded-lg overflow-hidden hover:-translate-y-0.5 hover:shadow-lg hover:shadow-black/40 hover:ring-1 hover:ring-indigo-500 transition"><div class="relative overflow-hidden"><img src="/image?pluginID=&amp;url=https://cdn.test/1.jpg" alt="One" class="w-full aspect-[2/3] object-cover" loading="lazy"></div><div class="p-3 flex-1 flex flex-col justify-between"><div class="font-medium text-sm mb-1 truncate" title="One">One</div><div class="flex items-center gap-1"></div></div></a>
<a href="/view/manga//2" class="flex flex-col bg-neutral-900 rounded-lg overflow-hidden hover:-translate-y-0.5 hover:shadow-lg hover:shadow-black/40 hover:ring-1 hover:ring-indigo-500 transition"><div class="relative overflow-hidden"><img src="/image?pluginID=&amp;url=https://cdn.test/2.jpg" alt="Two" class="w-full aspect-[2/3] object-cover" loading="lazy"></div><div class="p-3 flex-1 flex flex-col justify-between"><div class="font-medium text-sm mb-1 truncate" title="Two">Two</div><div class="flex items-center gap-1"></div></div></a></div>



<script>
(function(){
  var KEY = "gi_search_history", MAX = 20, MAX_SHOW = 8;
  function load() {
    try { var v = JSON.parse(localStorage.getItem(KEY) || "[]"); return Array.isArray(v) ? v : []; }
    catch (e) { return []; }
  }
  function save(h) { try { localStorage.setItem(KEY, JSON.stringify(h.slice(0, MAX))); } catch (e) {} }
  var qEl = document.getElementById("q"), pEl = document.getElementById("pluginID"), gEl = document.getElementById("genre");
  // Genres = checkbox selections, collected so old single-value history entries
  // keep working. Submitted as separate ?genre=<slug> params by the browser.
  var cbxs = gEl ? gEl.querySelectorAll('input[name="genre"]') : null;
  var genres = [];
  if (cbxs) {
    for (var i = 0; i < cbxs.length; i++) {
      if (cbxs[i].checked && cbxs[i].value) genres.push(cbxs[i].value);
    }
  }
  // Joined so old single-value history entries keep working unchanged.
  var q = qEl ? qEl.value : "", pid = pEl ? pEl.value : "", genre = genres.join(",");
  var pname = (pEl && pEl.dataset && pEl.dataset.pname) ? pEl.dataset.pname : pid;
  var h = load();
  if (q || genre) {
    h = h.filter(function(e) { return !(e.q === q && e.pid === pid && e.g === genre); });
    h.unshift({ q: q, pid: pid, pname: pname || "", g: genre || "" });
    save(h);
  }
  if (q || genre || !h.length) return;
  var box = document.getElementById("search-history");
  if (!box) return;
  var label = document.createElement("div");
  label.className = "text-xs text-neutral-400 mb-2";
  label.textContent = "Recent searches";
  box.appendChild(label);
  var grid = document.createElement("div");
  grid.className = "grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2";
  box.appendChild(grid);
  h.slice(0, MAX_SHOW).forEach(function (e) {
    var a = document.createElement("a");
    var url = "/view/search?pluginID=" + encodeURIComponent(e.pid || "") + "&q=" + encodeURIComponent(e.q || "");
    // e.g holds the genres joined by "," (one entry per selected genre).
    if (e.g) url += e.g.split(",").filter(Boolean).map(function (g) { return "&genre=" + encodeURIComponent(g); }).join("");
    a.href = url;
    a.className = "block truncate text-xs px-3 py-1.5 rounded-md bg-neutral-800 border border-neutral-700 text-neutral-300 hover:bg-neutral-700";
    a.title = (e.q || e.g) + (e.pname || e.pid ? " via " + (e.pname || e.pid) : "");
    var src = e.pname || e.pid || "";
    a.textContent = (e.q || e.g) + (src ? " via " + src : "");
    grid.appendChild(a);
  });
})();
</script>
    </main>
    <script src="/static/lib/alpine-components.js"></script>
    <script src="/static/lib/mermaid.min.js" defer></script>
    <script defer src="/static/lib/alpine.min.js"></script>
<div id="toast-region" x-data x-init="$store.toast.render($el)" class="fixed bottom-4 left-4 z-50 space-y-2"></div>

<style>
  .toast-item { opacity: 0; transform: translateY(8px); transition: opacity .18s ease, transform .18s ease; }
  .toast-item.toast-visible { opacity: 1; transform: translateY(0); }
  .toast-item.toast-leave { opacity: 0; transform: translateY(8px); }
</style>

<div id="confirm-modal" x-data x-init="$store.confirm.mount($el)" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50" style="display:none">
    <div class="relative bg-neutral-900 border border-neutral-700 rounded-lg shadow-xl w-full max-w-sm p-5">
        <p id="confirm-message" class="text-sm text-neutral-200 mb-4"></p>
        <div class="flex justify-end gap-2">
            <button type="button" id="confirm-cancel" class="border border-neutral-700 hover:bg-neutral-800 text-neutral-300 rounded-md px-3 py-1.5 text-sm">Cancel</button>
            <button type="button" id="confirm-ok" class="bg-red-600 hover:bg-red-500 text-white rounded-md px-3 py-1.5 text-sm font-medium">Confirm</button>
        </div>
    </div>
</div>
</body>
</html>