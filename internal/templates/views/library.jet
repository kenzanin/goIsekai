{{extends "/layouts/base.jet"}}

{{ block body() }}
<div class="flex items-center justify-between gap-3 mb-6">
    <h1 class="text-xl font-semibold shrink-0">Library</h1>
    <form method="get" action="/view/library" class="flex-1 max-w-md" role="search">
        <div class="flex gap-2">
            <input type="search" name="q" value="{{if isset(.Q)}}{{.Q}}{{end}}" placeholder="Search library…" class="w-full bg-neutral-900 border border-neutral-700 rounded-md px-3 py-1.5 text-sm placeholder-neutral-500 focus:outline-none focus:border-indigo-500">
            <button type="submit" class="border border-neutral-700 hover:bg-neutral-800 rounded-md px-3 py-1.5 text-sm font-medium">Search</button>
        </div>
    </form>
    <form method="post" action="/action/sync">
        <button type="submit" class="bg-indigo-600 hover:bg-indigo-500 text-white rounded-md px-4 py-2 text-sm font-medium">⟳ Update</button>
    </form>
</div>

{{if len(.Mangas) > 0}}
{{if .Q == ""}}
<div class="flex flex-col lg:flex-row gap-6">
    <aside class="lg:w-56 shrink-0 flex flex-col gap-3">
        <div class="bg-neutral-900 border border-neutral-700 rounded-lg px-4 py-3">
            <div class="text-xl font-semibold">{{.Stats.TotalTitles}}</div>
            <div class="text-xs text-neutral-400">titles</div>
        </div>
        <div class="bg-neutral-900 border border-neutral-700 rounded-lg px-4 py-3">
            <div class="text-xl font-semibold">{{.Stats.StatusLine}}</div>
            <div class="text-xs text-neutral-400">status</div>
        </div>
        <div class="bg-neutral-900 border border-neutral-700 rounded-lg px-4 py-3">
            <div class="text-xl font-semibold">{{.Stats.ReadLine}}</div>
            <div class="text-xs text-neutral-400">read</div>
        </div>
        {{if .Stats.HasUpdates > 0}}
        <div class="bg-neutral-900 border border-neutral-700 rounded-lg px-4 py-3">
            <div class="text-xl font-semibold text-indigo-400">{{.Stats.HasUpdates}}</div>
            <div class="text-xs text-neutral-400">updates</div>
        </div>
        {{end}}
        <div class="bg-neutral-900 border border-neutral-700 rounded-lg px-4 py-3">
            <div class="text-xl font-semibold">{{.Stats.ReadingTime}}</div>
            <div class="text-xs text-neutral-400">reading time</div>
        </div>
        {{if .Stats.MostLine != ""}}
        <div class="bg-neutral-900 border border-neutral-700 rounded-lg px-4 py-3">
            <div class="text-xl font-semibold">{{.Stats.MostLine}}</div>
            <div class="text-xs text-neutral-400">most chapters</div>
        </div>
        {{end}}
        {{if .Stats.HasFewest}}
        <div class="bg-neutral-900 border border-neutral-700 rounded-lg px-4 py-3">
            <div class="text-xl font-semibold">{{.Stats.FewestLine}}</div>
            <div class="text-xs text-neutral-400">fewest chapters</div>
        </div>
        {{end}}
        {{if isset(.Duplicates) && .Duplicates > 0}}
        <details class="bg-neutral-900 border border-neutral-700 rounded-lg overflow-hidden">
            <summary class="px-4 py-3 cursor-pointer select-none text-sm font-medium text-neutral-200 hover:bg-neutral-800/60 transition list-none flex items-center justify-between gap-2">
                <span>Duplicate <span class="text-indigo-400 font-semibold">{{.Duplicates}}</span></span>
                <svg class="w-4 h-4 text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </summary>
            <div class="border-t border-neutral-800 px-3 py-3 flex flex-col gap-4">
                {{range gi, g := .DuplicateGroups}}
                <div class="flex flex-col gap-2">
                    <div class="text-xs font-medium text-neutral-300 line-clamp-2" title="{{g.Title}}">{{g.Title}}</div>
                    <div class="flex flex-col gap-1.5">
                        {{range mi, m := g.Members}}
                        <a href="/view/manga/{{m.PluginID}}/{{m.SourceMangaID}}" class="flex items-center gap-2 rounded-md px-2 py-1.5 hover:bg-neutral-800/60 transition group">
                            {{if m.CoverURL != ""}}
                            <img src="/image?pluginID={{m.PluginID}}&amp;url={{m.CoverURL}}" alt="{{m.Title}}" class="w-8 h-11 object-cover rounded shrink-0" loading="lazy">
                            {{else}}
                            <div class="w-8 h-11 rounded bg-neutral-800 flex items-center justify-center text-[10px] text-neutral-500 font-semibold shrink-0">{{getInitials(m.Title)}}</div>
                            {{end}}
                            <span class="text-xs text-neutral-300 line-clamp-2 group-hover:text-neutral-100">{{m.Title}}</span>
                        </a>
                        {{end}}
                    </div>
                </div>
                {{end}}
            </div>
        </details>
        {{end}}
    </aside>
    <div class="flex-1 min-w-0">
{{end}}
{{end}}

{{if len(.Mangas) == 0}}
<div class="py-16 text-center text-neutral-500">
    <p class="mb-2">Your library is empty — search for manga first</p>
    <a href="/view/search" class="text-indigo-400 hover:text-indigo-300 text-sm">Search manga</a>
</div>
{{else}}
<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
    {{range i, m := .Mangas }}
    {{ stats := statAt(.LibraryStats, m.ID) }}
    <a href="/view/manga/{{m.PluginID}}/{{m.SourceMangaID}}" class="bg-neutral-900 rounded-lg overflow-hidden relative hover:-translate-y-0.5 hover:shadow-lg hover:shadow-black/40 transition">
        {{if m.CoverURL != ""}}
        {{if ratioAt(.Ratios, m.PluginID) > 0}}
        <img src="/image?pluginID={{m.PluginID}}&amp;url={{m.CoverURL}}" alt="{{m.Title}}" style="aspect-ratio: {{ratioAt(.Ratios, m.PluginID)}}" class="w-full object-cover" loading="lazy">
        {{else}}
        <img src="/image?pluginID={{m.PluginID}}&amp;url={{m.CoverURL}}" alt="{{m.Title}}" class="w-full aspect-[2/3] object-cover" loading="lazy">
        {{end}}
        {{else}}
        <div class="w-full aspect-[2/3] bg-neutral-800 flex items-center justify-center text-neutral-500 text-2xl font-semibold">{{getInitials(m.Title)}}</div>
        {{end}}
        {{if m.Status != ""}}
        <span class="absolute top-2 left-2 bg-black/60 backdrop-blur rounded-full px-2 py-0.5 text-[10px] text-neutral-200">{{m.Status}}</span>
        {{end}}
        <div class="p-3">
            <div class="text-sm font-medium line-clamp-2" title="{{m.Title}}">{{m.Title}}</div>
            {{if stats}}
            <div class="flex items-center gap-2 mt-1">
                <span class="rounded-full text-[11px] px-2 py-0.5 bg-neutral-800 text-neutral-400"><span class="text-indigo-400 font-medium">{{stats.TotalChapters - stats.ReadChapters}} unread</span> of {{stats.TotalChapters}} · {{stats.PluginName}}</span>
                {{if stats.HasNew}}
                <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-red-500 text-white font-medium">New</span>
                {{end}}
            </div>
            {{end}}
        </div>
    </a>
    {{end}}
</div>
{{ p := pagination(`/`, `page`, .Page, .TotalPages) }}
{{ include "/partials/pagination.jet" p }}
{{end}}
{{if len(.Mangas) > 0}}
{{if .Q == ""}}
    </div>
</div>
{{end}}
{{end}}
{{ end }}
