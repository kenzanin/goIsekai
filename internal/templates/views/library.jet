{{extends "/layouts/base.jet"}}

{{ block body() }}
<div class="flex items-center justify-between mb-6">
    <h1 class="text-xl font-semibold">Library</h1>
    <form method="post" action="/action/sync">
        <button type="submit" class="bg-indigo-600 hover:bg-indigo-500 text-white rounded-md px-4 py-2 text-sm font-medium">⟳ Update</button>
    </form>
</div>

{{if len(.Mangas) == 0}}
<div class="py-16 text-center text-neutral-500">
    <p class="mb-2">Your library is empty — search for manga first</p>
    <a href="/view/search" class="text-indigo-400 hover:text-indigo-300 text-sm">Search manga</a>
</div>
{{else}}
<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-4">
    {{range i, m := .Mangas }}
    {{ stats := statAt(.LibraryStats, m.ID) }}
    <a href="/view/manga/{{m.PluginID}}/{{m.SourceMangaID}}" class="bg-neutral-900 rounded-lg overflow-hidden relative hover:-translate-y-0.5 hover:shadow-lg hover:shadow-black/40 transition">
        {{if m.CoverURL != ""}}
        {{if ratioAt(.Ratios, m.PluginID) > 0}}
        <img src="/image?pluginID={{m.PluginID}}&amp;url={{m.CoverURL}}" alt="{{m.Title}}" style="aspect-ratio: {{ratioAt(.Ratios, m.PluginID)}}" class="w-full object-cover" loading="lazy">
        {{else}}
        <img src="/image?pluginID={{m.PluginID}}&amp;url={{m.CoverURL}}" alt="{{m.Title}}" class="w-full aspect-[2/3] object-cover" loading="lazy">
        {{end}}
        {{else}}
        <div class="w-full aspect-[2/3] bg-neutral-800 flex items-center justify-center text-neutral-500 text-2xl font-semibold">{{getInitials(m.Title)}}</div>
        {{end}}
        {{if m.Status != ""}}
        <span class="absolute top-2 left-2 bg-black/60 backdrop-blur rounded-full px-2 py-0.5 text-[10px] text-neutral-200">{{m.Status}}</span>
        {{end}}
        <div class="p-3">
            <div class="text-sm font-medium line-clamp-2" title="{{m.Title}}">{{m.Title}}</div>
            {{if stats}}
            <div class="flex items-center gap-2 mt-1">
                <span class="rounded-full text-[11px] px-2 py-0.5 bg-neutral-800 text-neutral-400"><span class="text-indigo-400 font-medium">{{stats.TotalChapters - stats.ReadChapters}} unread</span> of {{stats.TotalChapters}} · {{stats.PluginName}}</span>
                {{if stats.HasNew}}
                <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-red-500 text-white font-medium">New</span>
                {{end}}
            </div>
            {{end}}
        </div>
        </div>
    </a>
    {{end}}
</div>
{{if .HasNext}}
<a href="?page={{.Page + 1}}" class="border border-neutral-700 hover:bg-neutral-800 rounded-md px-3 py-1.5 text-sm">Next →</a>
{{end}}
</div>
{{end}}
{{ end }}
