{{extends "/layouts/base.jet"}}

{{ block body() }}
<h1 class="text-xl font-semibold mb-6">Search</h1>

<form method="get" action="/view/search" class="flex flex-wrap items-end gap-3 mb-8">
    <div>
        <label for="pluginID" class="block text-sm font-medium mb-1">Plugin</label>
        <select id="pluginID" name="pluginID" class="bg-neutral-900 border border-neutral-700 rounded-md px-3 py-2 text-sm">
            {{range i, p := .Plugins }}
            {{if p.IsActive}}
            <option value="{{p.ID}}" {{if .PluginID == p.ID}}selected{{end}}>{{p.Name}}</option>
            {{end}}
            {{end}}
        </select>
    </div>
    <div class="flex-1 min-w-[200px]">
        <label for="q" class="block text-sm font-medium mb-1">Query</label>
        <input id="q" name="q" type="text" value="{{.Q}}" placeholder="Judul manga..." class="w-full bg-neutral-900 border border-neutral-700 rounded-md px-3 py-2 text-sm">
    </div>
    <button type="submit" class="bg-indigo-600 hover:bg-indigo-500 text-white rounded-md px-4 py-2 text-sm font-medium">Cari</button>
</form>

{{if .Results}}
<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-4">
    {{range i, r := .Results }}
    <a href="/view/manga/{{.PluginID}}/{{r.ID}}" class="bg-neutral-900 rounded-lg overflow-hidden hover:ring-1 hover:ring-indigo-500 transition">
        {{if r.CoverURL != ""}}
        <img src="/image?pluginID={{.PluginID}}&amp;url={{r.CoverURL}}" alt="{{r.Title}}" class="h-64 w-full object-cover" loading="lazy">
        {{else}}
        <div class="h-64 w-full bg-neutral-800 flex items-center justify-center text-neutral-500 text-2xl font-semibold">{{getInitials(r.Title)}}</div>
        {{end}}
        <div class="p-3">
            <div class="text-sm font-medium line-clamp-2">{{r.Title}}</div>
        </div>
    </a>
    {{end}}
</div>
{{else}}
{{if .Q != ""}}
<div class="py-16 text-center text-neutral-500">Tidak ada hasil untuk "{{.Q}}"</div>
{{end}}
{{end}}
{{ end }}
