{{extends "/layouts/base.jet"}}

{{ block body() }}
<div class="flex items-center justify-between mb-6">
    <h1 class="text-xl font-semibold">Plugins</h1>
    <form method="post" action="/action/install-plugin" enctype="multipart/form-data" class="flex items-center gap-2">
        <input type="file" name="file" accept=".wasm" class="text-xs text-neutral-400 file:mr-2 file:bg-neutral-800 file:border-0 file:rounded-md file:px-3 file:py-1.5 file:text-sm file:text-neutral-200">
        <button type="submit" class="bg-indigo-600 hover:bg-indigo-500 text-white rounded-md px-4 py-2 text-sm font-medium">Install</button>
    </form>
</div>

{{if len(.Plugins) == 0}}
<div class="py-16 text-center text-neutral-500">No plugins installed</div>
{{else}}
<div class="space-y-3">
    {{range i, p := .Plugins }}
    <div class="bg-neutral-900 rounded-lg p-4 flex items-center justify-between gap-4">
        <div class="flex items-center gap-3 min-w-0">
            {{if p.IconURL != ""}}
            <img src="{{p.IconURL}}" alt="" class="h-10 w-10 rounded-md object-cover bg-neutral-800">
            {{end}}
            <div class="min-w-0">
                <div class="font-medium text-sm">{{p.Name}}</div>
                <div class="text-xs font-mono text-neutral-500 truncate">{{p.ID}}</div>
            </div>
        </div>
        <div class="flex items-center gap-2 shrink-0">
            {{if p.Version != ""}}
            <span class="text-xs px-2 py-0.5 rounded-full bg-neutral-700/50 text-neutral-400">v{{p.Version}}</span>
            {{end}}
            {{if p.IsActive}}
            <span class="text-xs px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400">Active</span>
            {{else}}
            <span class="text-xs px-2 py-0.5 rounded-full bg-neutral-700/50 text-neutral-400">Inactive</span>
            {{end}}
            <form method="post" action="/action/toggle-plugin/{{p.ID}}">
                <button type="submit" class="border border-neutral-700 hover:bg-neutral-800 rounded-md px-3 py-1.5 text-sm">
                    {{if p.IsActive}}Deactivate{{else}}Activate{{end}}
                </button>
            </form>
        </div>
    </div>
    {{end}}
</div>
{{end}}
{{ end }}
