{{extends "/layouts/base.jet"}}

{{ block body() }}
<div class="flex items-center justify-between mb-6">
    <h1 class="text-xl font-semibold">Plugins</h1>
    <form method="post" action="/action/install-plugin" enctype="multipart/form-data" class="flex items-center gap-2">
        <label for="plugin-file" class="cursor-pointer border border-dashed border-neutral-700 rounded-md px-3 py-2 text-sm text-neutral-400 hover:border-indigo-500">Choose plugin…</label>
        <input type="file" id="plugin-file" name="file" accept=".wasm,.js,.lua,.so" class="sr-only">
        <button type="submit" class="bg-indigo-600 hover:bg-indigo-500 text-white rounded-md px-4 py-2 text-sm font-medium">Install</button>
    </form>
</div>

{{if len(.Plugins) == 0}}
<div class="py-16 text-center text-neutral-500">No plugins installed</div>
{{else}}
<div class="space-y-3">
    {{range i, p := .Plugins }}
    <div class="bg-neutral-900 rounded-lg p-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-3 min-w-0">
            {{if p.IconURL != ""}}
            <img src="{{p.IconURL}}" alt="" class="h-10 w-10 rounded-md object-cover bg-neutral-800">
            {{else}}
            <div class="h-10 w-10 rounded-md bg-neutral-800 flex items-center justify-center text-sm font-semibold text-neutral-400 shrink-0">{{p.Name[:1]}}</div>
            {{end}}
            <div class="min-w-0">
                <div class="font-medium text-sm">{{p.Name}}</div>
                <div class="text-xs font-mono text-neutral-500 truncate">{{p.ID}}</div>
                {{if p.SiteURL != ""}}
                <a href="{{p.SiteURL}}" target="_blank" rel="noopener" class="text-xs text-indigo-400 hover:text-indigo-300 truncate">{{p.SiteURL}}</a>
                {{end}}
            </div>
        </div>
            <div class="flex items-center gap-2 shrink-0 flex-wrap">
            {{if p.Version != ""}}
            <span class="text-xs px-2 py-0.5 rounded-full bg-neutral-700/50 text-neutral-400">v{{p.Version}}</span>
            {{end}}
            {{if p.IsActive}}
            <span class="text-xs px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400">Active</span>
            {{else}}
            <span class="text-xs px-2 py-0.5 rounded-full bg-neutral-700/50 text-neutral-400">Inactive</span>
            {{end}}
            {{if p.Loaded}}
            <span class="text-xs px-2 py-0.5 rounded-full bg-sky-500/15 text-sky-400">Loaded</span>
            {{else}}
            <span class="text-xs px-2 py-0.5 rounded-full bg-amber-500/15 text-amber-400">Deferred</span>
            {{end}}
            <form method="post" action="/action/toggle-plugin/{{p.ID}}">
                <button type="submit" class="border border-neutral-700 text-neutral-400 hover:text-neutral-200 rounded-md px-3 py-1.5 text-sm">
                    {{if p.IsActive}}Deactivate{{else}}Activate{{end}}
                </button>
            </form>
        </div>
    </div>
    {{if p.NeedsHumanVerify}}
    <div class="bg-neutral-900 rounded-lg p-4 border border-neutral-800">
        <div class="flex items-center justify-between gap-3 mb-3">
            <div class="text-sm font-medium">Human Verification</div>
            {{if len(p.VerifyCookies) > 0}}
            <span class="text-xs px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400">Verified ✓</span>
            {{else}}
            <span class="text-xs px-2 py-0.5 rounded-full bg-amber-500/15 text-amber-400">Not verified — site requires a browser challenge</span>
            {{end}}
        </div>
        {{if len(p.VerifyURL) > 0}}
        <a href="{{p.VerifyURL}}" target="_blank" rel="noopener" class="inline-block bg-indigo-600 hover:bg-indigo-500 text-white rounded-md px-3 py-1.5 text-sm font-medium mb-3">Open verification page</a>
        {{end}}
        <form method="post" action="/action/save-verify/{{p.ID}}" class="space-y-2">
            <textarea name="cookies" rows="3" placeholder="cf_clearance=... or the full cookie header" class="w-full bg-neutral-800 border border-neutral-700 rounded-md px-3 py-2 text-sm font-mono">{{p.VerifyCookies}}</textarea>
            <input type="text" name="user_agent" value="{{p.VerifyUserAgent}}" placeholder="Browser User-Agent (optional — must match the browser that solved the challenge)" class="w-full bg-neutral-800 border border-neutral-700 rounded-md px-3 py-2 text-xs font-mono">
            <button type="submit" class="bg-indigo-600 hover:bg-indigo-500 text-white rounded-md px-4 py-1.5 text-sm font-medium">Save</button>
        </form>
        <details class="mt-3">
            <summary class="text-xs text-neutral-400 cursor-pointer hover:text-neutral-200">How to copy cookies</summary>
            <ol class="list-decimal list-inside text-xs text-neutral-400 space-y-1 mt-2 pl-1">
                <li>Open the verification page and complete the challenge.</li>
                <li>Press F12 &rarr; Network tab &rarr; refresh the page.</li>
                <li>Click the first request &rarr; Request Headers &rarr; find the <code>cookie:</code> line.</li>
                <li>Right-click &rarr; Copy value.</li>
                <li>Paste everything into the box above.</li>
            </ol>
        </details>
    </div>
    {{end}}
    {{if p.Loaded}}
    <div class="bg-neutral-900 rounded-lg p-4 border border-neutral-800">
        <div class="flex items-center justify-between gap-3 mb-3">
            <div class="text-sm font-medium">TLS Profile</div>
            {{if p.PinnedProfile != ""}}
            <span class="text-xs px-2 py-0.5 rounded-full bg-sky-500/15 text-sky-400">Pinned: {{p.PinnedProfile}}</span>
            {{else}}
            <span class="text-xs px-2 py-0.5 rounded-full bg-neutral-700/50 text-neutral-400">Auto (ladder)</span>
            {{end}}
        </div>
        <div class="flex items-center gap-2 flex-wrap">
            <select data-plugin-profile="{{p.ID}}" class="bg-neutral-800 border border-neutral-700 rounded-md px-3 py-1.5 text-sm">
                <option value="">Auto (ladder)</option>
                {{range _, name := p.AvailableProfiles}}
                <option value="{{name}}" {{if name == p.PinnedProfile}}selected{{end}}>{{name}}</option>
                {{end}}
            </select>
            <button type="button" onclick="testProfile('{{p.ID}}')" class="border border-neutral-700 text-neutral-400 hover:text-neutral-200 rounded-md px-3 py-1.5 text-sm">Test</button>
            {{if p.PinnedProfile != ""}}
            <button type="button" onclick="resetProfile('{{p.ID}}')" class="border border-red-800/50 text-red-400 hover:text-red-300 rounded-md px-3 py-1.5 text-sm">Reset</button>
            {{end}}
        </div>
    </div>
    {{end}}
    {{end}}
</div>
{{end}}

<script>
document.querySelectorAll('input[type=file]').forEach(inp => {
  inp.addEventListener('change', function() {
    var label = this.previousElementSibling;
    if (label) label.textContent = this.files[0] ? this.files[0].name : 'Choose .wasm…';
  });
});

function testProfile(pluginID) {
  var sel = document.querySelector('[data-plugin-profile="' + pluginID + '"]');
  var profile = sel.value;
  if (!profile) { showToast('Select a profile first', true); return; }
  var btn = sel.nextElementSibling;
  btn.disabled = true;
  btn.textContent = 'Testing…';
  fetch('/action/test-profile/' + pluginID, {
    method: 'POST',
    headers: {'Content-Type': 'application/x-www-form-urlencoded'},
    body: 'profile=' + encodeURIComponent(profile)
  }).then(function(r) { return r.json(); })
    .then(function(d) {
      btn.disabled = false;
      btn.textContent = 'Test';
      if (d.ok) {
        showToast('OK ' + d.status + ' via ' + profile, false);
      } else {
        showToast(profile + ' → ' + d.status + ' blocked', true);
      }
    })
    .catch(function() {
      btn.disabled = false;
      btn.textContent = 'Test';
      showToast('Test request failed', true);
    });
}

function resetProfile(pluginID) {
  fetch('/action/reset-profile/' + pluginID, {method: 'POST'})
    .then(function(r) { return r.json(); })
    .then(function() { showToast('Profile reset to auto'); location.reload(); })
    .catch(function() { showToast('Reset failed', true); });
}
</script>
{{ end }}
