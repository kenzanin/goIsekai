{{extends "/layouts/base.jet"}}

{{ block body() }}
<div class="flex items-center justify-between mb-6">
    <h1 class="text-xl font-semibold">Plugins</h1>
    <form method="post" action="/action/install-plugin" enctype="multipart/form-data" class="flex items-center gap-2">
        <input type="file" name="file" accept=".wasm" class="text-xs text-neutral-400 file:mr-2 file:bg-neutral-800 file:border-0 file:rounded-md file:px-3 file:py-1.5 file:text-sm file:text-neutral-200">
        <button type="submit" class="bg-indigo-600 hover:bg-indigo-500 text-white rounded-md px-4 py-2 text-sm font-medium">Install</button>
    </form>
</div>

{{if len(.Plugins) == 0}}
<div class="py-16 text-center text-neutral-500">No plugins installed</div>
{{else}}
<div class="space-y-3">
    {{range i, p := .Plugins }}
    <div class="bg-neutral-900 rounded-lg p-4 flex items-center justify-between gap-4">
        <div class="flex items-center gap-3 min-w-0">
            {{if p.IconURL != ""}}
            <img src="{{p.IconURL}}" alt="" class="h-10 w-10 rounded-md object-cover bg-neutral-800">
            {{end}}
            <div class="min-w-0">
                <div class="font-medium text-sm">{{p.Name}}</div>
                <div class="text-xs font-mono text-neutral-500 truncate">{{p.ID}}</div>
            </div>
        </div>
        <div class="flex items-center gap-2 shrink-0">
            {{if p.Version != ""}}
            <span class="text-xs px-2 py-0.5 rounded-full bg-neutral-700/50 text-neutral-400">v{{p.Version}}</span>
            {{end}}
            {{if p.IsActive}}
            <span class="text-xs px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400">Active</span>
            {{else}}
            <span class="text-xs px-2 py-0.5 rounded-full bg-neutral-700/50 text-neutral-400">Inactive</span>
            {{end}}
            <form method="post" action="/action/toggle-plugin/{{p.ID}}">
                <button type="submit" class="border border-neutral-700 hover:bg-neutral-800 rounded-md px-3 py-1.5 text-sm">
                    {{if p.IsActive}}Deactivate{{else}}Activate{{end}}
                </button>
            </form>
        </div>
    </div>
    {{if p.NeedsHumanVerify}}
    <div class="bg-neutral-900 rounded-lg p-4 border border-neutral-800">
        <div class="flex items-center justify-between gap-3 mb-3">
            <div class="text-sm font-medium">Human Verification</div>
            {{if len(p.VerifyCookies) > 0}}
            <span class="text-xs px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400">Verified ✓</span>
            {{else}}
            <span class="text-xs px-2 py-0.5 rounded-full bg-amber-500/15 text-amber-400">Not verified — site requires a browser challenge</span>
            {{end}}
        </div>
        {{if len(p.VerifyURL) > 0}}
        <a href="{{p.VerifyURL}}" target="_blank" rel="noopener" class="inline-block bg-indigo-600 hover:bg-indigo-500 text-white rounded-md px-3 py-1.5 text-sm font-medium mb-3">Open verification page</a>
        {{end}}
        <form method="post" action="/action/save-verify/{{p.ID}}" class="space-y-2">
            <textarea name="cookies" rows="3" placeholder="cf_clearance=... or the full cookie header" class="w-full bg-neutral-800 border border-neutral-700 rounded-md px-3 py-2 text-sm font-mono">{{p.VerifyCookies}}</textarea>
            <input type="text" name="user_agent" value="{{p.VerifyUserAgent}}" placeholder="Browser User-Agent (optional — must match the browser that solved the challenge)" class="w-full bg-neutral-800 border border-neutral-700 rounded-md px-3 py-2 text-xs font-mono">
            <button type="submit" class="bg-indigo-600 hover:bg-indigo-500 text-white rounded-md px-4 py-1.5 text-sm font-medium">Save</button>
        </form>
        <details class="mt-3">
            <summary class="text-xs text-neutral-400 cursor-pointer hover:text-neutral-200">How to copy cookies</summary>
            <ol class="list-decimal list-inside text-xs text-neutral-400 space-y-1 mt-2 pl-1">
                <li>Open the verification page and complete the challenge.</li>
                <li>Press F12 &rarr; Network tab &rarr; refresh the page.</li>
                <li>Click the first request &rarr; Request Headers &rarr; find the <code>cookie:</code> line.</li>
                <li>Right-click &rarr; Copy value.</li>
                <li>Paste everything into the box above.</li>
            </ol>
        </details>
    </div>
    {{end}}
    {{end}}
</div>
{{end}}
{{ end }}
