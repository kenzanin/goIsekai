{{extends "/layouts/base.jet"}}

{{ block body() }}
<div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
    <div class="md:col-span-1">
        {{if .Manga.CoverURL != ""}}
        <img src="/image?pluginID={{.PluginID}}&amp;url={{.Manga.CoverURL}}" alt="{{.Manga.Title}}" class="w-full rounded-lg object-cover">
        {{else}}
        <div class="w-full aspect-[2/3] bg-neutral-800 rounded-lg flex items-center justify-center text-neutral-500 text-4xl font-semibold">{{getInitials(.Manga.Title)}}</div>
        {{end}}
    </div>
    <div class="md:col-span-3">
        <h1 class="text-2xl font-semibold mb-2">{{.Manga.Title}}</h1>
        <div class="flex flex-wrap gap-2 mb-3">
            {{if .Manga.Status != ""}}
            <span class="text-xs px-2 py-0.5 rounded-full bg-neutral-700/50 text-neutral-400">{{.Manga.Status}}</span>
            {{end}}
            {{range i, g := .Manga.Genres }}
            <span class="text-xs px-2 py-0.5 rounded-full bg-indigo-500/15 text-indigo-400">{{g}}</span>
            {{end}}
        </div>
        {{if .Manga.Author != ""}}
        <p class="text-sm text-neutral-400 mb-2">{{.Manga.Author}}</p>
        {{end}}
        {{if .Manga.Description != ""}}
        <p class="text-sm text-neutral-400 mb-4">{{.Manga.Description}}</p>
        {{end}}
        <div class="flex flex-wrap items-center gap-2 mb-4">
            {{if .Continue}}
            <a href="/view/read/{{.PluginID}}/{{.MangaID}}/{{.Continue.ChapterID}}?page={{.Continue.Page}}" class="bg-indigo-600 hover:bg-indigo-500 text-white rounded-md px-4 py-2 text-sm font-medium">
                {{if .Continue.Page > 1}}▶ Continue Reading: Ch. {{formatChapterNum(.Continue.ChapterN)}} · p. {{.Continue.Page}}{{else}}▶ Start Reading{{end}}
            </a>
            {{end}}
            <form method="post" action="/action/toggle-library/{{.PluginID}}/{{.MangaID}}">
                {{if .InLibrary}}<button type="submit" class="bg-emerald-600 hover:bg-emerald-500 text-white rounded-md px-4 py-2 text-sm font-medium">✓ In Library</button>{{else}}<button type="submit" class="bg-neutral-700 hover:bg-neutral-600 text-white rounded-md px-4 py-2 text-sm font-medium">+ Add to Library</button>{{end}}
            </form>
        </div>
    </div>
</div>

<h2 class="text-xl font-semibold mb-4">Chapters</h2>
{{if len(.Chapters) == 0}}
<div class="py-16 text-center text-neutral-500">No chapters yet</div>
{{else}}
<div class="divide-y divide-neutral-800">
    {{range i, c := .Chapters }}
    <a href="/view/read/{{.PluginID}}/{{.MangaID}}/{{c.ID}}" class="flex items-center justify-between gap-4 py-3 px-2 -mx-2 rounded hover:bg-neutral-900 transition">
        <span class="text-sm">
            <span class="text-neutral-400 mr-2">Ch. {{formatChapterNum(c.ChapterNum)}}</span>
            {{if .Progress[c.ID].TotalPages > 0}}{{if .Progress[c.ID].LastPageRead >= .Progress[c.ID].TotalPages}}<span class="line-through text-neutral-500">{{c.Title}}</span>{{else}}{{c.Title}}{{end}}{{end}}
        </span>
        <span class="flex items-center gap-2 shrink-0">
            {{if .Progress[c.ID].LastPageRead > 0}}
            <span class="text-xs px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400">{{.Progress[c.ID].LastPageRead}}{{if .Progress[c.ID].TotalPages > 0}}/{{.Progress[c.ID].TotalPages}}{{end}}</span>
            {{end}}
            {{if .Progress[c.ID].TotalPages > 0}}{{if .Progress[c.ID].LastPageRead >= .Progress[c.ID].TotalPages}}
            <span class="text-emerald-400 text-xs">✓</span>
            {{end}}{{end}}
            <span class="text-xs text-neutral-500">{{formatDate(c.ReleasedAt.Format("2006-01-02T15:04:05"))}}</span>
        </span>
    </a>
    {{end}}
</div>
{{end}}
{{ end }}
