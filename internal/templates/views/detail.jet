{{extends "/layouts/base.jet"}}

{{ block body() }}
<div class="mb-4">
    <button onclick="if (history.length > 1) { history.back(); } else { window.location.href = '/view/library'; }" class="inline-flex items-center gap-1.5 text-sm text-neutral-400 hover:text-neutral-200 transition" aria-label="Back">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        Back
    </button>
</div>
{{if .Challenge}}
<div class="bg-amber-500/15 border border-amber-500/40 text-amber-300 rounded-lg p-4 mb-6">This site needs human verification — go to <a href="/view/plugins" class="underline">Plugins &rarr; Human Verification</a> to paste your session cookies.</div>
{{end}}
<div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
    <div class="md:col-span-1">
        {{if .Manga.CoverURL != ""}}
        <img src="/image?pluginID={{.PluginID}}&amp;url={{.Manga.CoverURL}}" alt="{{.Manga.Title}}" class="w-full aspect-[2/3] rounded-lg object-cover">
        {{else}}
        <div class="w-full aspect-[2/3] bg-neutral-800 rounded-lg flex items-center justify-center text-neutral-500 text-4xl font-semibold">{{getInitials(.Manga.Title)}}</div>
        {{end}}
    </div>
    <div class="md:col-span-3">
        <h1 class="text-2xl font-semibold mb-2">{{.Manga.Title}}</h1>
        <div class="flex flex-wrap gap-2 mb-3">
            <span class="text-xs px-2 py-0.5 rounded-full bg-neutral-800 text-neutral-500">{{.PluginID}}</span>
            {{if .Manga.Status != ""}}
            <span class="text-xs px-2 py-0.5 rounded-full bg-neutral-700/50 text-neutral-400">{{.Manga.Status}}</span>
            {{end}}
            {{range i, g := .Manga.Genres }}
            <span class="text-xs px-2 py-0.5 rounded-full bg-indigo-500/15 text-indigo-400">{{g}}</span>
            {{end}}
        </div>
        {{if .Manga.Author != ""}}
        <p class="text-sm text-neutral-400 mb-2">{{.Manga.Author}}</p>
        {{end}}
        {{if .Manga.Description != ""}}
        <p class="text-sm text-neutral-400 mb-4">{{.Manga.Description}}</p>
        {{end}}
        <div class="mb-4">
            <div class="flex items-center gap-2 mb-1.5">
                <span class="text-xs font-semibold text-neutral-300 uppercase tracking-wide">Alternative titles</span>
            </div>
            {{if len(.AltTitles) > 0}}
            <div class="flex flex-wrap gap-1.5 mb-2">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-neutral-800 border border-indigo-700/60 pl-2.5 pr-1 py-0.5 text-xs">
                    <span class="text-indigo-300" title="Current main title">{{.CurrentTitle}}</span>
                    <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-indigo-900/40 text-indigo-300">via {{.PluginID}}</span>
                </span>
                {{range _, t := .AltTitles }}
                <span class="inline-flex items-center gap-1.5 rounded-full bg-neutral-800 border border-neutral-700/60 pl-2.5 pr-1 py-0.5 text-xs">
                    <form method="post" action="/action/set-title/{{.PluginID}}/{{.MangaID}}" class="inline">
                        <input type="hidden" name="title" value="{{t.Title}}">
                        <button type="submit" title="Set as main title" class="text-neutral-300 hover:text-indigo-300" onclick="return confirm('Set as main title?')">{{t.Title}}</button>
                    </form>
                    {{if t.Source != ""}}
                    <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-neutral-700/50 text-neutral-400">via {{t.Source}}</span>
                    {{end}}
                    <form method="post" action="/action/remove-alt-title/{{.PluginID}}/{{.MangaID}}" class="inline-flex">
                        <input type="hidden" name="title" value="{{t.Title}}">
                        <button type="submit" title="Remove alternative title" aria-label="Remove" class="size-4 inline-flex items-center justify-center rounded-full text-neutral-500 hover:text-red-400 hover:bg-neutral-700" onclick="return confirm('Are you sure?')">&times;</button>
                    </form>
                </span>
                {{end}}
            </div>
            {{end}}
            {{if len(.AltTitleServers) > 0}}
            <form method="post" action="/action/fetch-alt-titles/{{.PluginID}}/{{.MangaID}}" class="flex flex-wrap items-center gap-2">
                <select name="server" class="bg-neutral-900 border border-neutral-700 rounded-md px-2 py-1.5 text-xs text-neutral-300 focus:outline-none focus:border-indigo-500">
                    {{range _, s := .AltTitleServers }}
                    <option value="{{s.ServerID}}">{{s.Name}}</option>
                    {{end}}
                </select>
                <button type="submit" class="border border-neutral-700 hover:bg-neutral-800 rounded-md px-3 py-1.5 text-xs font-medium inline-flex items-center gap-1.5">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                    Get alternative titles
                </button>
            </form>
            {{else}}
            <p class="text-xs text-neutral-500">No alt-title providers available — install a plugin that declares alt-title servers.</p>
            {{end}}
        </div>
        <div class="flex flex-wrap items-center gap-2 mb-4">
            <form method="post" action="/action/toggle-library/{{.PluginID}}/{{.MangaID}}">
                {{if .InLibrary}}<button type="submit" class="border border-emerald-600/50 text-emerald-400 bg-emerald-500/10 hover:bg-emerald-500/20 rounded-md px-4 py-2 text-sm">✓ In Library</button>{{else}}<button type="submit" class="bg-indigo-600 hover:bg-indigo-500 text-white rounded-md px-4 py-2 text-sm font-medium">+ Add to Library</button>{{end}}
            </form>
            {{if .Continue}}
            <a href="/view/read/{{.PluginID}}/{{.MangaID}}/{{.Continue.ChapterID}}?page={{.Continue.Page}}" class="bg-indigo-600 hover:bg-indigo-500 text-white rounded-md px-4 py-2 text-sm font-medium" title="{{if .Continue.Page > 1}}Continue: Ch. {{formatChapterNum(.Continue.ChapterN)}}, page {{.Continue.Page}}{{else}}Start Reading{{end}}">
                {{if .Continue.Page > 1}}▶ Continue · Ch.{{formatChapterNum(.Continue.ChapterN)}}{{else}}▶ Start Reading{{end}}
            </a>
            {{end}}
        </div>
    </div>
</div>

<h2 class="text-xl font-semibold mb-4">Chapters</h2>
{{if len(.Chapters) == 0}}
<div class="py-16 text-center text-neutral-500">No chapters yet</div>
{{else}}
<div class="flex flex-wrap items-center gap-2 mb-4">
    <form id="mark-bulk" method="post" action="/action/mark-read-bulk">
        <input type="hidden" name="pluginID" value="{{.PluginID}}">
        <input type="hidden" name="mangaID" value="{{.MangaID}}">
        <button type="submit" class="bg-indigo-600 hover:bg-indigo-500 text-white rounded-md px-3 py-1.5 text-sm font-medium">Mark selected as read</button>
    </form>
    <form method="post" action="/action/reset-progress-all/{{.PluginID}}/{{.MangaID}}">
        <button type="submit" title="Clear read progress for every chapter" class="bg-transparent border border-red-900/60 text-red-400 hover:bg-red-950/40 rounded-md px-3 py-1.5 text-sm" onclick="return confirm('Are you sure?')">↺ Reset all read status</button>
    </form>
    <form method="post" action="/action/clear-cache/{{.PluginID}}/{{.MangaID}}" onsubmit="return confirm('Clear cached images for this manga?');">
        <button type="submit" title="Delete cached image files for this manga" class="bg-transparent border border-red-900/60 text-red-400 hover:bg-red-950/40 rounded-md px-3 py-1.5 text-sm">🗑 Clear cached images</button>
    </form>
</div>
{{ firstID := "" }}
{{cp := pagination(``, `ChPage`, .ChCurrentPage, .ChTotalPages)}}
{{include "/partials/pagination.jet" cp}}
<div class="divide-y divide-neutral-800">
    {{range i, c := .Chapters }}
    {{if i == 0}}{{ firstID = c.ID }}{{end}}
    <div class="flex items-center gap-3 py-3 px-2 -mx-2 rounded hover:bg-neutral-900 transition">
        <input type="checkbox" name="chapterIDs" value="{{c.ID}}" form="mark-bulk" class="size-4 accent-indigo-600 shrink-0">
        <a href="/view/read/{{.PluginID}}/{{.MangaID}}/{{c.ID}}" class="flex-1 flex items-center justify-between gap-4 min-w-0">
            <span class="text-sm">
                <span class="text-neutral-400 mr-2">Ch. {{formatChapterNum(c.ChapterNum)}}</span>
                {{if .Progress[c.ID].Done}}<span class="line-through text-neutral-500">{{c.Title}}</span>{{else}}{{c.Title}}{{end}}
            </span>
            <span class="flex items-center gap-2 shrink-0">
                {{if .Progress[c.ID].TotalPages > 0}}
                <span class="text-xs px-2 py-0.5 rounded-full bg-neutral-800 text-neutral-400">{{.Progress[c.ID].LastPageRead}}/{{.Progress[c.ID].TotalPages}} read{{if .Progress[c.ID].CachedPages > 0}} · {{.Progress[c.ID].CachedPages}} cached{{end}}</span>
                {{else if .Progress[c.ID].CachedPages > 0}}
                <span class="text-xs px-2 py-0.5 rounded-full bg-neutral-800 text-neutral-400">{{.Progress[c.ID].CachedPages}} cached</span>
                {{end}}
                {{if .Progress[c.ID].Done}}
                <span class="text-emerald-400 text-xs">✓</span>
                {{end}}
                {{if c.ReleasedAt.Format("2006") != "0001"}}
                <span class="text-xs text-neutral-500">{{formatDate(c.ReleasedAt.Format("2006-01-02T15:04:05"))}}</span>
                {{end}}
            </span>
        </a>
        <form method="post" action="/action/mark-read/{{.PluginID}}/{{.MangaID}}/{{c.ID}}">
            <button type="submit" title="Mark read" class="size-7 inline-flex items-center justify-center rounded-md border border-neutral-700 hover:bg-neutral-800 text-sm" aria-label="Mark read"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><polyline points="20 6 9 17 4 12"/></svg></button>
        </form>
        <form method="post" action="/action/reset-progress/{{.PluginID}}/{{.MangaID}}/{{c.ID}}">
            <button type="submit" title="Reset progress" class="size-7 inline-flex items-center justify-center rounded-md border border-neutral-700 hover:bg-neutral-800 text-sm" aria-label="Reset progress" onclick="return confirm('Are you sure?')"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg></button>
        </form>
        <form method="post" action="/action/mark-read-range/{{.PluginID}}/{{.MangaID}}/{{firstID}}/{{c.ID}}">
            <button type="submit" title="Mark up to here" class="size-7 inline-flex items-center justify-center rounded-md border border-neutral-700 hover:bg-neutral-800 text-sm" aria-label="Mark up to here"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="M18 6L7 17l-5-5"/><path d="M22 10l-7.5 7.5L13 16"/></svg></button>
        </form>
        <form method="post" action="/action/export-cbz/{{.PluginID}}/{{.MangaID}}/{{c.ID}}">
            <input type="hidden" name="title" value="{{.Manga.Title}} - Ch. {{formatChapterNum(c.ChapterNum)}}">
            <button type="submit" title="Download this chapter as .cbz" class="h-7 px-2 inline-flex items-center justify-center rounded-md border border-neutral-700 hover:bg-neutral-800 text-sm whitespace-nowrap">⬇ cbz</button>
        </form>
    </div>
    {{end}}
</div>
{{cp2 := pagination(``, `ChPage`, .ChCurrentPage, .ChTotalPages)}}
{{include "/partials/pagination.jet" cp2}}
{{end}}
{{ end }}
