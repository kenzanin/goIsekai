wasi_sdk := env_var_or_default("WASI_SDK", "/opt/wasi-sdk")

# Build WASM from C++17 via wasi-sdk clang++ (reactor, libc++, RapidJSON).
build:
    ./build.sh

check:
    /sbin/wasm-objdump -x main.wasm | grep -E '"(malloc|free|_initialize|contract_version)"'
    @echo "Size: $(stat -c%s main.wasm) bytes"

clean:
    rm -f main.wasm

default: build
