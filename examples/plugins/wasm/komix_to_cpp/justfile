zig := "zig"

# Build WASM from C++ via zig cc (freestanding: no libc, no stdlib)
# C++ compiles to the same freestanding WAT as C — just no stdlib.
build:
    {{zig}} cc -x c++ -std=c++20 -target wasm32-freestanding -O2 main.cpp -o main.wasm -nostdlib -Wl,--no-entry
    @echo "Built main.wasm ($(stat -c%s main.wasm) bytes)"

check:
    wasm-objdump -h main.wasm | grep -E "count:"
    @echo "Size: $(stat -c%s main.wasm) bytes"

clean:
    rm -f main.wasm

default: build
