zig := "zig"

# Build WASM from C via zig cc (freestanding: no libc, no stdlib)
# Each ABI function exports a packed i64: (ptr << 32) | len
build:
    {{zig}} cc -target wasm32-freestanding -O2 main.c -o main.wasm -nostdlib -Wl,--no-entry
    @echo "Built main.wasm ($(stat -c%s main.wasm) bytes)"

check:
    wasm-objdump -h main.wasm | grep -E "(Export|Import|count)"
    wasm-objdump -j .import main.wasm 2>/dev/null || true
    @echo "Size: $(stat -c%s main.wasm) bytes"

clean:
    rm -f main.wasm

default: build
